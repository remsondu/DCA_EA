//+------------------------------------------------------------------+
//|                                             CybowDCA_Clone.mq5   |
//|                     DCA / averaging basket engine - buy & sell   |
//|                                                     CybowPoint   |
//+------------------------------------------------------------------+
//  Based on the "My Demo bot #2" DCA bot (Eliro):
//     Asset            XAUUSDm
//     Entry            Instantly (market)
//     Initial order    0.10 lot
//     Extra order      0.15 lots
//     Extra orders     5
//     Extra step       1380 pips  (= $13.80 on gold)
//     Amount mult      1.5x
//     Step mult        1.3x
//     Take Profit      230 pips   (= $2.30 from basket average)
//     Stop Loss        OFF
//
//  v2.00 - Buy AND sell.
//     Trade mode: Buy only / Sell only / Buy and sell.
//     Buy basket  = market buy + buy limits BELOW, TP above average.
//     Sell basket = market sell + sell limits ABOVE, TP below average.
//
//     AO guard (M15):
//       Green bar -> may start a BUY cycle
//       Red bar   -> may start a SELL cycle
//     By default only one basket runs at a time. Set InpAllowHedge to
//     let a buy and a sell basket run together (hedging accounts only).
//
//     Major-trend guard (H1):
//       Major sell = H1 AO < 0 and H1 close < EMA 200
//       Major buy  = H1 AO > 0 and H1 close > EMA 200
//       Major sell: no new BUY cycles; an open buy basket is closed on
//                   the pullback UP (bounce exit or fade exit).
//       Major buy:  no new SELL cycles; an open sell basket is closed on
//                   the pullback DOWN (mirror of the above).
//       Pullback exit: counter-move >= X * ATR(M15) from the basket's
//                      extreme (lowest bid for buys, highest ask for sells).
//       Fade exit:     M15 AO showed the pullback colour on the trend
//                      side of zero, then flipped back (trend resuming).
//     Those exits usually book a LOSS - a smaller one than riding the
//     ladder into the next leg.
//
//  v2.10 - High-impact news filter (MT5 Economic Calendar).
//     No new cycle starts from 10 min before a high-impact event until
//     30 min after it (both adjustable). Overlapping events extend the
//     pause to the latest end time. Currencies default to the symbol's
//     own (USD for XAUUSD). Open baskets keep being managed (TP, exits).
//     Calendar data is not available in the Strategy Tester, so the
//     filter switches itself off there and says so in the log.
//
//  WARNING: no stop loss. Full ladder = 2.16 lots on gold = ~$216 per
//  $1 of adverse move past the last rung, in EITHER direction.
//+------------------------------------------------------------------+
#property copyright "CybowPoint"
#property link      "https://youtube.com/@CybowPoint"
#property version   "2.10"

#include <Trade\Trade.mqh>

enum ENUM_TRADE_MODE
  {
   TM_BUY_ONLY  = 0,  // Buy only
   TM_SELL_ONLY = 1,  // Sell only
   TM_BOTH      = 2   // Buy and sell
  };

#define SIDE_BUY  0
#define SIDE_SELL 1

//--- inputs -------------------------------------------------------
input group           "=== Identity ==="
input long            InpMagic            = 260917;     // Magic number
input string          InpComment          = "CybowDCA";

input group           "=== Main settings ==="
input ENUM_TRADE_MODE InpTradeMode        = TM_BOTH;    // Trade direction
input bool            InpAllowHedge       = false;      // Allow buy + sell baskets at the same time

input group           "=== Order settings ==="
input double          InpInitialLots      = 0.10;       // Initial order amount
input double          InpExtraLots        = 0.15;       // Extra order amount
input int             InpExtraOrders      = 5;          // Extra orders
input double          InpStepPips         = 1380;       // Extra orders step (pips)
input double          InpLotMultiplier    = 1.5;        // Amount multiplier
input double          InpStepMultiplier   = 1.3;        // Step multiplier

input group           "=== Exit condition ==="
input double          InpTakeProfitPips   = 230;        // Take Profit (pips from average)

input group           "=== Awesome Oscillator guard ==="
input bool            InpUseAOGuard       = true;       // Use AO guard (green = buy, red = sell)
input ENUM_TIMEFRAMES InpAOTimeframe      = PERIOD_M15; // AO timeframe
input int             InpAOShift          = 1;          // AO bar to read (1 = last closed, 0 = live)

input group           "=== Major-trend guard ==="
input bool            InpUseTrendGuard    = true;       // Use major-trend guard
input ENUM_TIMEFRAMES InpRegimeTF         = PERIOD_H1;  // Major-trend timeframe
input int             InpRegimeEMA        = 200;        // EMA period on that timeframe
input bool            InpRegimeNeedsEMA   = true;       // Also require close beyond EMA
input bool            InpExitOnPullback   = true;       // Close basket when pullback reaches size
input double          InpPullbackATR      = 1.5;        // Pullback size (x ATR on AO timeframe)
input int             InpATRPeriod        = 14;         // ATR period
input bool            InpExitOnFade       = true;       // Close basket when pullback fades

input group           "=== News filter ==="
input bool            InpUseNewsFilter    = true;       // Pause new cycles around high-impact news
input int             InpNewsMinsBefore   = 10;         // Pause minutes BEFORE news
input int             InpNewsMinsAfter    = 30;         // Resume minutes AFTER news
input string          InpNewsCurrencies   = "";         // Currencies, comma list (blank = symbol's own)
input bool            InpNewsBlockOnError = true;       // Block entries if calendar is unavailable

input group           "=== Technical ==="
input double          InpPipOverride      = 0.0;        // Pip size override (0 = auto)
input int             InpSlippagePoints   = 50;         // Max deviation (points)
input bool            InpAutoRestartCycle = true;       // Restart cycle after TP

//--- globals ------------------------------------------------------
CTrade   trade;
double   g_pip      = 0.0;
double   g_point    = 0.0;
double   g_tick     = 0.0;
int      g_digits   = 0;
bool     g_halted   = false;
bool     g_hedge    = false;

int      g_aoHandle = INVALID_HANDLE;   // AO on InpAOTimeframe
int      g_regAO    = INVALID_HANDLE;   // AO on InpRegimeTF
int      g_regEMA   = INVALID_HANDLE;   // EMA on InpRegimeTF
int      g_atr      = INVALID_HANDLE;   // ATR on InpAOTimeframe
string   g_status   = "";

// per-side state, index SIDE_BUY / SIDE_SELL
double   g_lastVol[2];
double   g_lastTP[2];
double   g_ext[2];        // buy: lowest bid, sell: highest ask since basket opened
bool     g_pullSeen[2];   // pullback against the major trend has started
bool     g_exiting[2];    // basket close in progress, retry until flat

// market snapshot, refreshed every tick
bool     g_aoOK     = false;
bool     g_aoGreen  = false;
double   g_ao0      = 0.0;
bool     g_regOK    = false;
int      g_regime   = 0;  // +1 major buy, -1 major sell, 0 none

// news filter state
bool     g_newsActive    = false;   // filter really running (off in tester)
string   g_newsCur[];               // currencies to watch
datetime g_newsTime[];              // high-impact event times (server time)
string   g_newsName[];              // "USD Nonfarm Payrolls" etc.
datetime g_newsNextLoad  = 0;
bool     g_newsOK        = false;
int      g_newsLastCount = -1;
bool     g_newsBlocked   = false;
string   g_newsInfo      = "";

//+------------------------------------------------------------------+
int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(InpSlippagePoints);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.LogLevel(LOG_LEVEL_ERRORS);

   g_digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   g_point  = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   g_tick   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(g_tick <= 0.0)
      g_tick = g_point;

   if(InpPipOverride > 0.0)
      g_pip = InpPipOverride;
   else
      g_pip = (g_digits == 3 || g_digits == 5) ? g_point * 10.0 : g_point;

   if(InpExtraOrders < 0 || InpInitialLots <= 0.0 || InpTakeProfitPips <= 0.0 || InpAOShift < 0 ||
      InpRegimeEMA < 1 || InpATRPeriod < 1 || InpPullbackATR <= 0.0 ||
      InpNewsMinsBefore < 0 || InpNewsMinsAfter < 0)
     {
      Print("Invalid inputs.");
      return(INIT_PARAMETERS_INCORRECT);
     }

   ResetSide(SIDE_BUY);
   ResetSide(SIDE_SELL);

   if(InpAllowHedge)
     {
      if(AccountInfoInteger(ACCOUNT_MARGIN_MODE) == ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
         g_hedge = true;
      else
         Print("Account is not a hedging account: buy and sell baskets will run one at a time.");
     }

   if(InpUseAOGuard || InpUseTrendGuard)
     {
      g_aoHandle = iAO(_Symbol, InpAOTimeframe);
      if(g_aoHandle == INVALID_HANDLE)
        {
         PrintFormat("Failed to create AO handle: %d", GetLastError());
         return(INIT_FAILED);
        }
     }

   if(InpUseTrendGuard)
     {
      g_regAO  = iAO(_Symbol, InpRegimeTF);
      g_regEMA = iMA(_Symbol, InpRegimeTF, InpRegimeEMA, 0, MODE_EMA, PRICE_CLOSE);
      g_atr    = iATR(_Symbol, InpAOTimeframe, InpATRPeriod);
      if(g_regAO == INVALID_HANDLE || g_regEMA == INVALID_HANDLE || g_atr == INVALID_HANDLE)
        {
         PrintFormat("Failed to create major-trend guard handles: %d", GetLastError());
         return(INIT_FAILED);
        }
     }

   // News filter setup
   g_newsActive = false;
   if(InpUseNewsFilter)
     {
      if(MQLInfoInteger(MQL_TESTER))
         Print("News filter: Economic Calendar is not available in the Strategy Tester - filter OFF for this test.");
      else
        {
         BuildNewsCurrencies();
         if(ArraySize(g_newsCur) == 0)
            Print("News filter: no currencies to watch - filter OFF.");
         else
           {
            g_newsActive   = true;
            g_newsNextLoad = 0;   // load on first tick
           }
        }
     }

   PrintFormat("CybowDCA v2.10 | mode %s | hedge %s | AO guard %s (%s) | trend guard %s (%s) | news %s",
               EnumToString(InpTradeMode), g_hedge ? "ON" : "OFF",
               InpUseAOGuard ? "ON" : "OFF", TFName(InpAOTimeframe),
               InpUseTrendGuard ? "ON" : "OFF", TFName(InpRegimeTF),
               g_newsActive ? StringFormat("ON (-%d/+%d min, %s)", InpNewsMinsBefore,
                                           InpNewsMinsAfter, NewsCurrencyList()) : "OFF");

   if(SideEnabled(SIDE_BUY))
      PrintLadderPreview(SIDE_BUY);
   if(SideEnabled(SIDE_SELL))
      PrintLadderPreview(SIDE_SELL);
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   if(g_aoHandle != INVALID_HANDLE) IndicatorRelease(g_aoHandle);
   if(g_regAO    != INVALID_HANDLE) IndicatorRelease(g_regAO);
   if(g_regEMA   != INVALID_HANDLE) IndicatorRelease(g_regEMA);
   if(g_atr      != INVALID_HANDLE) IndicatorRelease(g_atr);
   Comment("");
   Print("CybowDCA_Clone stopped. Open positions and pendings were left in place.");
  }

//+------------------------------------------------------------------+
void OnTick()
  {
   if(g_halted)
      return;

   ReadMarket();
   g_newsBlocked = NewsBlocked(g_newsInfo);

   // 1) Manage whatever baskets are open.
   for(int s = SIDE_BUY; s <= SIDE_SELL; s++)
     {
      if(CountPositions(s) == 0)
        {
         ResetSide(s);
         DeletePendings(s);
         continue;
        }

      if(g_exiting[s])
        {
         CloseBasket(s, "retrying pullback exit");
         continue;
        }

      string reason = "";
      if(InpUseTrendGuard && CheckPullbackExit(s, reason))
        {
         g_exiting[s] = true;
         CloseBasket(s, reason);
         continue;
        }

      ManageBasket(s);
     }

   // 2) Start new cycles where allowed (not during a news pause).
   if(!g_newsBlocked)
      TryStartCycles();

   UpdateStatus();
  }

//+------------------------------------------------------------------+
void ResetSide(const int s)
  {
   g_lastVol[s]  = -1.0;
   g_lastTP[s]   = -1.0;
   g_ext[s]      = 0.0;
   g_pullSeen[s] = false;
   g_exiting[s]  = false;
  }

//+------------------------------------------------------------------+
bool SideEnabled(const int s)
  {
   if(InpTradeMode == TM_BOTH)
      return(true);
   if(s == SIDE_BUY)
      return(InpTradeMode == TM_BUY_ONLY);
   return(InpTradeMode == TM_SELL_ONLY);
  }

//+------------------------------------------------------------------+
string SideName(const int s)
  {
   return(s == SIDE_BUY ? "BUY" : "SELL");
  }

//+------------------------------------------------------------------+
//| NEWS FILTER                                                       |
//+------------------------------------------------------------------+
void BuildNewsCurrencies()
  {
   ArrayResize(g_newsCur, 0);

   string src = InpNewsCurrencies;
   StringTrimLeft(src);
   StringTrimRight(src);
   if(src == "")
      src = SymbolInfoString(_Symbol, SYMBOL_CURRENCY_BASE) + "," +
            SymbolInfoString(_Symbol, SYMBOL_CURRENCY_PROFIT);

   string parts[];
   int n = StringSplit(src, ',', parts);
   for(int i = 0; i < n; i++)
     {
      string c = parts[i];
      StringTrimLeft(c);
      StringTrimRight(c);
      StringToUpper(c);
      if(c == "")
         continue;

      bool dup = false;
      for(int k = 0; k < ArraySize(g_newsCur); k++)
         if(g_newsCur[k] == c) { dup = true; break; }
      if(dup)
         continue;

      int m = ArraySize(g_newsCur);
      ArrayResize(g_newsCur, m + 1);
      g_newsCur[m] = c;
     }
  }

//+------------------------------------------------------------------+
string NewsCurrencyList()
  {
   string out = "";
   for(int i = 0; i < ArraySize(g_newsCur); i++)
      out += (i > 0 ? "," : "") + g_newsCur[i];
   return(out);
  }

//+------------------------------------------------------------------+
//| Pull high-impact events for the watched currencies, from just     |
//| behind "now" (so a running post-news pause is kept) to +24h.      |
//| Currencies the calendar doesn't know (e.g. XAU) are skipped.      |
//+------------------------------------------------------------------+
bool LoadNews()
  {
   MqlCalendarCountry countries[];
   if(CalendarCountries(countries) <= 0)
      return(false);                       // calendar DB not available (yet)

   ArrayResize(g_newsTime, 0);
   ArrayResize(g_newsName, 0);

   datetime now  = TimeTradeServer();
   datetime from = now - (datetime)((InpNewsMinsAfter + 1) * 60);
   datetime to   = now + 24 * 3600;

   for(int c = 0; c < ArraySize(g_newsCur); c++)
     {
      bool known = false;
      for(int k = 0; k < ArraySize(countries); k++)
         if(countries[k].currency == g_newsCur[c]) { known = true; break; }
      if(!known)
         continue;

      MqlCalendarValue vals[];
      CalendarValueHistory(vals, from, to, NULL, g_newsCur[c]);

      for(int i = 0; i < ArraySize(vals); i++)
        {
         MqlCalendarEvent ev;
         if(!CalendarEventById(vals[i].event_id, ev))
            continue;
         if(ev.importance != CALENDAR_IMPORTANCE_HIGH)
            continue;
         if(ev.time_mode != CALENDAR_TIMEMODE_DATETIME)
            continue;                      // skip all-day / tentative items

         int n = ArraySize(g_newsTime);
         ArrayResize(g_newsTime, n + 1);
         ArrayResize(g_newsName, n + 1);
         g_newsTime[n] = vals[i].time;
         g_newsName[n] = g_newsCur[c] + " " + ev.name;
        }
     }

   if(ArraySize(g_newsTime) != g_newsLastCount)
     {
      g_newsLastCount = ArraySize(g_newsTime);
      PrintFormat("News filter: %d high-impact event(s) for %s in the next 24h.",
                  g_newsLastCount, NewsCurrencyList());
      for(int i = 0; i < ArraySize(g_newsTime); i++)
         PrintFormat("   %s  %s", TimeToString(g_newsTime[i], TIME_DATE | TIME_MINUTES), g_newsName[i]);
     }
   return(true);
  }

//+------------------------------------------------------------------+
//| true = inside a news window, no new cycles                        |
//+------------------------------------------------------------------+
bool NewsBlocked(string &info)
  {
   info = "";
   if(!g_newsActive)
      return(false);

   datetime now = TimeTradeServer();
   if(now >= g_newsNextLoad)
     {
      g_newsOK       = LoadNews();
      g_newsNextLoad = now + (g_newsOK ? 300 : 60);   // refresh 5 min, retry 1 min
     }

   if(!g_newsOK)
     {
      info = "news calendar unavailable" + (InpNewsBlockOnError ? " - entries paused" : "");
      return(InpNewsBlockOnError);
     }

   datetime until = 0;
   string   what  = "";
   int      pre   = InpNewsMinsBefore * 60;
   int      post  = InpNewsMinsAfter * 60;

   for(int i = 0; i < ArraySize(g_newsTime); i++)
     {
      datetime t = g_newsTime[i];
      if(now >= t - pre && now < t + post && t + post > until)
        {
         until = t + post;
         what  = g_newsName[i] + " @ " + TimeToString(t, TIME_MINUTES);
        }
     }

   if(until > 0)
     {
      info = StringFormat("NEWS PAUSE until %s (%s)", TimeToString(until, TIME_MINUTES), what);
      return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
//| Read M15 AO colour and the H1 major-trend regime                  |
//+------------------------------------------------------------------+
void ReadMarket()
  {
   g_aoOK = false;
   if(g_aoHandle != INVALID_HANDLE)
     {
      double ao[];
      ArraySetAsSeries(ao, true);
      if(CopyBuffer(g_aoHandle, 0, InpAOShift, 2, ao) == 2)
        {
         g_aoOK    = true;
         g_aoGreen = (ao[0] >= ao[1]);   // same colour rule as MT5's built-in AO
         g_ao0     = ao[0];
        }
     }

   g_regOK  = false;
   g_regime = 0;
   if(!InpUseTrendGuard)
      return;

   double rao[];
   ArraySetAsSeries(rao, true);
   if(CopyBuffer(g_regAO, 0, 1, 1, rao) < 1)
      return;

   bool emaBear = true, emaBull = true;
   if(InpRegimeNeedsEMA)
     {
      double ema[];
      ArraySetAsSeries(ema, true);
      if(CopyBuffer(g_regEMA, 0, 1, 1, ema) < 1)
         return;
      double cls = iClose(_Symbol, InpRegimeTF, 1);
      if(cls <= 0.0)
         return;
      emaBear = (cls < ema[0]);
      emaBull = (cls > ema[0]);
     }

   g_regOK = true;
   if(rao[0] < 0.0 && emaBear)
      g_regime = -1;
   else if(rao[0] > 0.0 && emaBull)
      g_regime = 1;
  }

//+------------------------------------------------------------------+
bool EntryAllowed(const int s)
  {
   if(InpUseTrendGuard)
     {
      if(!g_regOK)
         return(false);
      if(s == SIDE_BUY  && g_regime < 0)
         return(false);             // no buys into a major sell
      if(s == SIDE_SELL && g_regime > 0)
         return(false);             // no sells into a major buy
     }

   if(InpUseAOGuard)
     {
      if(!g_aoOK)
         return(false);
      return(s == SIDE_BUY ? g_aoGreen : !g_aoGreen);
     }
   return(true);
  }

//+------------------------------------------------------------------+
void TryStartCycles()
  {
   if(!InpAutoRestartCycle && GlobalVariableCheck("CybowDCA_ran_" + (string)InpMagic))
      return;

   int n[2];
   n[SIDE_BUY]  = CountPositions(SIDE_BUY);
   n[SIDE_SELL] = CountPositions(SIDE_SELL);

   for(int s = SIDE_BUY; s <= SIDE_SELL; s++)
     {
      int other = (s == SIDE_BUY) ? SIDE_SELL : SIDE_BUY;
      if(!SideEnabled(s) || n[s] > 0)
         continue;
      if(n[other] > 0 && !g_hedge)
         continue;
      if(g_exiting[other])
         continue;
      if(!EntryAllowed(s))
         continue;
      if(StartCycle(s))
         n[s] = 1;
     }
  }

//+------------------------------------------------------------------+
//| Against a major trend, close the basket on the pullback before    |
//| the next leg. Buy basket in a major sell: exit on the move up.    |
//| Sell basket in a major buy: exit on the move down.                |
//+------------------------------------------------------------------+
bool CheckPullbackExit(const int s, string &reason)
  {
   double price = (s == SIDE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID)
                                  : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(price <= 0.0)
      return(false);

   if(g_ext[s] <= 0.0 ||
      (s == SIDE_BUY  && price < g_ext[s]) ||
      (s == SIDE_SELL && price > g_ext[s]))
      g_ext[s] = price;

   if(!g_regOK || !g_aoOK)
      return(false);

   bool against = (s == SIDE_BUY && g_regime < 0) || (s == SIDE_SELL && g_regime > 0);
   if(!against)
     {
      g_pullSeen[s] = false;
      return(false);
     }

   bool pullColour = (s == SIDE_BUY) ? g_aoGreen : !g_aoGreen;   // colour of the pullback
   bool trendSide  = (s == SIDE_BUY) ? (g_ao0 < 0.0) : (g_ao0 > 0.0);

   if(pullColour && trendSide && !g_pullSeen[s])
     {
      g_pullSeen[s] = true;
      PrintFormat("%s basket vs major %s: pullback %s in progress.", SideName(s),
                  s == SIDE_BUY ? "sell" : "buy", s == SIDE_BUY ? "up" : "down");
     }

   if(InpExitOnPullback)
     {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(g_atr, 0, 1, 1, atr) == 1 && atr[0] > 0.0)
        {
         double move = (s == SIDE_BUY) ? price - g_ext[s] : g_ext[s] - price;
         if(move >= InpPullbackATR * atr[0])
           {
            reason = StringFormat("%s basket vs major %s: pullback %s off %s (>= %.2f x ATR %s)",
                                  SideName(s), s == SIDE_BUY ? "sell" : "buy",
                                  DoubleToString(move, g_digits), DoubleToString(g_ext[s], g_digits),
                                  InpPullbackATR, DoubleToString(atr[0], g_digits));
            return(true);
           }
        }
     }

   if(InpExitOnFade && g_pullSeen[s] && !pullColour && trendSide)
     {
      reason = StringFormat("%s basket vs major %s: pullback faded, trend resuming",
                            SideName(s), s == SIDE_BUY ? "sell" : "buy");
      return(true);
     }

   return(false);
  }

//+------------------------------------------------------------------+
//| Open the initial market order and lay out the whole ladder        |
//+------------------------------------------------------------------+
bool StartCycle(const int s)
  {
   if(!SymbolIsTradable())
      return(false);

   double lots = NormalizeLots(InpInitialLots);
   if(lots <= 0.0)
      return(false);

   double entry;
   bool   ok;
   string cmt = StringFormat("%s %s #0", InpComment, SideName(s));

   if(s == SIDE_BUY)
     {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      ok    = trade.Buy(lots, _Symbol, 0.0, 0.0, 0.0, cmt);
     }
   else
     {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      ok    = trade.Sell(lots, _Symbol, 0.0, 0.0, 0.0, cmt);
     }

   if(!ok)
     {
      PrintFormat("%s initial order failed: %d %s", SideName(s), trade.ResultRetcode(),
                  trade.ResultRetcodeDescription());
      return(false);
     }

   double fill = trade.ResultPrice();
   if(fill <= 0.0)
      fill = entry;

   GlobalVariableSet("CybowDCA_ran_" + (string)InpMagic, (double)TimeCurrent());

   ResetSide(s);
   PlaceLadder(s, fill);
   PrintFormat("%s cycle started at %s", SideName(s), DoubleToString(fill, g_digits));
   return(true);
  }

//+------------------------------------------------------------------+
//| Buy limits below the entry, or sell limits above it               |
//+------------------------------------------------------------------+
void PlaceLadder(const int s, const double basePrice)
  {
   double step  = InpStepPips * g_pip;
   double price = basePrice;
   double lot   = InpExtraLots;

   for(int i = 0; i < InpExtraOrders; i++)
     {
      lot = NormalizeLots(lot);          // round first ...
      if(lot <= 0.0)
         break;

      price = NormalizePrice(s == SIDE_BUY ? price - step : price + step);
      string cmt = StringFormat("%s %s #%d", InpComment, SideName(s), i + 1);

      bool ok = (s == SIDE_BUY)
                ? trade.BuyLimit(lot, price, _Symbol, 0.0, 0.0, ORDER_TIME_GTC, 0, cmt)
                : trade.SellLimit(lot, price, _Symbol, 0.0, 0.0, ORDER_TIME_GTC, 0, cmt);

      if(!ok)
         PrintFormat("%s safety order %d failed at %s: %d %s", SideName(s), i + 1,
                     DoubleToString(price, g_digits), trade.ResultRetcode(),
                     trade.ResultRetcodeDescription());

      step *= InpStepMultiplier;
      lot  *= InpLotMultiplier;          // ... then multiply the rounded value
     }
  }

//+------------------------------------------------------------------+
//| Recalculate the basket average and push the shared TP out         |
//+------------------------------------------------------------------+
void ManageBasket(const int s)
  {
   double vol = 0.0, weighted = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(!IsOurPosition(ticket, s))
         continue;
      double v = PositionGetDouble(POSITION_VOLUME);
      vol      += v;
      weighted += v * PositionGetDouble(POSITION_PRICE_OPEN);
     }

   if(vol <= 0.0)
      return;

   double avg    = weighted / vol;
   double tpDist = InpTakeProfitPips * g_pip;
   double target = NormalizePrice(s == SIDE_BUY ? avg + tpDist : avg - tpDist);

   if(MathAbs(vol - g_lastVol[s]) < 1e-8 && MathAbs(target - g_lastTP[s]) < g_tick / 2.0)
      return;

   double stops = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * g_point;
   double bid   = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask   = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   // Price already through the target - take it at market instead.
   if((s == SIDE_BUY  && target <= bid + stops) ||
      (s == SIDE_SELL && target >= ask - stops))
     {
      CloseBasket(s, "target reached inside stops level");
      return;
     }

   int modified = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(!IsOurPosition(ticket, s))
         continue;

      double curTP = PositionGetDouble(POSITION_TP);
      double curSL = PositionGetDouble(POSITION_SL);
      if(MathAbs(curTP - target) < g_tick / 2.0)
         continue;

      if(trade.PositionModify(ticket, curSL, target))
         modified++;
     }

   if(modified > 0)
      PrintFormat("%s basket %.2f lots | avg %s | TP %s", SideName(s),
                  vol, DoubleToString(avg, g_digits), DoubleToString(target, g_digits));

   g_lastVol[s] = vol;
   g_lastTP[s]  = target;
  }

//+------------------------------------------------------------------+
void CloseBasket(const int s, const string reason)
  {
   PrintFormat("Closing %s basket at market: %s", SideName(s), reason);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(!IsOurPosition(ticket, s))
         continue;
      trade.PositionClose(ticket, InpSlippagePoints);
     }
   DeletePendings(s);
  }

//+------------------------------------------------------------------+
void DeletePendings(const int s)
  {
   ENUM_ORDER_TYPE want = (s == SIDE_BUY) ? ORDER_TYPE_BUY_LIMIT : ORDER_TYPE_SELL_LIMIT;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0)
         continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol)
         continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagic)
         continue;
      if((ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE) != want)
         continue;
      trade.OrderDelete(ticket);
     }
  }

//+------------------------------------------------------------------+
int CountPositions(const int s)
  {
   int n = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(IsOurPosition(ticket, s))
         n++;
     }
   return(n);
  }

//+------------------------------------------------------------------+
double BasketLots(const int s)
  {
   double v = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(IsOurPosition(ticket, s))
         v += PositionGetDouble(POSITION_VOLUME);
     }
   return(v);
  }

//+------------------------------------------------------------------+
bool IsOurPosition(const ulong ticket, const int s)
  {
   if(ticket == 0)
      return(false);
   if(!PositionSelectByTicket(ticket))
      return(false);
   if(PositionGetString(POSITION_SYMBOL) != _Symbol)
      return(false);
   if(PositionGetInteger(POSITION_MAGIC) != InpMagic)
      return(false);
   ENUM_POSITION_TYPE t = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
   return(s == SIDE_BUY ? t == POSITION_TYPE_BUY : t == POSITION_TYPE_SELL);
  }

//+------------------------------------------------------------------+
void UpdateStatus()
  {
   string trend = "trend guard off";
   if(InpUseTrendGuard)
      trend = !g_regOK ? "trend n/a"
            : g_regime > 0 ? "MAJOR BUY (" + TFName(InpRegimeTF) + ")"
            : g_regime < 0 ? "MAJOR SELL (" + TFName(InpRegimeTF) + ")"
            : "no major trend";

   string ao = !g_aoOK ? "AO n/a"
             : TFName(InpAOTimeframe) + (g_aoGreen ? " AO green" : " AO red");

   string baskets = "";
   for(int s = SIDE_BUY; s <= SIDE_SELL; s++)
     {
      double v = BasketLots(s);
      if(v <= 0.0)
         continue;
      baskets += StringFormat(" | %s basket %.2f lots%s", SideName(s), v,
                              g_pullSeen[s] ? " (pullback, exit armed)" : "");
     }
   if(baskets == "")
      baskets = g_newsBlocked ? " | flat" : " | flat, waiting for signal";

   string news = (g_newsInfo != "") ? " | " + g_newsInfo : "";

   SetStatus(trend + " | " + ao + baskets + news);
  }

//+------------------------------------------------------------------+
void SetStatus(const string info)
  {
   if(info == g_status)
      return;
   g_status = info;

   string msg = "CybowDCA | " + info;
   Print(msg);
   Comment(msg);
  }

//+------------------------------------------------------------------+
string TFName(const ENUM_TIMEFRAMES tf)
  {
   string s = EnumToString(tf);
   StringReplace(s, "PERIOD_", "");
   return(s);
  }

//+------------------------------------------------------------------+
bool SymbolIsTradable()
  {
   long mode = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE);
   if(mode == SYMBOL_TRADE_MODE_DISABLED || mode == SYMBOL_TRADE_MODE_CLOSEONLY)
      return(false);
   if(!MQLInfoInteger(MQL_TRADE_ALLOWED) || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return(false);
   if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED) || !AccountInfoInteger(ACCOUNT_TRADE_EXPERT))
      return(false);
   return(true);
  }

//+------------------------------------------------------------------+
double NormalizeLots(const double lots)
  {
   double mn = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double mx = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(st <= 0.0)
      st = 0.01;

   double v = MathRound(lots / st) * st;
   v = MathMax(mn, MathMin(mx, v));
   return(NormalizeDouble(v, LotDigits(st)));
  }

//+------------------------------------------------------------------+
int LotDigits(const double step)
  {
   int d = 0;
   double s = step;
   while(s < 1.0 && d < 8)
     {
      s *= 10.0;
      d++;
     }
   return(d);
  }

//+------------------------------------------------------------------+
double NormalizePrice(const double price)
  {
   if(g_tick <= 0.0)
      return(NormalizeDouble(price, g_digits));
   return(NormalizeDouble(MathRound(price / g_tick) * g_tick, g_digits));
  }

//+------------------------------------------------------------------+
//| Log what a ladder will look like before anything is risked        |
//+------------------------------------------------------------------+
void PrintLadderPreview(const int s)
  {
   double ref = (s == SIDE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                                : SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double step      = InpStepPips * g_pip;
   double lot       = InpExtraLots;
   double totalLots = NormalizeLots(InpInitialLots);
   double price     = ref;

   PrintFormat("--- CybowDCA %s ladder preview (pip = %s) ---", SideName(s),
               DoubleToString(g_pip, g_digits));
   PrintFormat("  #0 market   %8s  %.2f lots",
               DoubleToString(NormalizePrice(ref), g_digits), totalLots);

   for(int i = 0; i < InpExtraOrders; i++)
     {
      lot = NormalizeLots(lot);
      price = (s == SIDE_BUY) ? price - step : price + step;
      totalLots += lot;
      PrintFormat("  #%d limit    %8s  %.2f lots",
                  i + 1, DoubleToString(NormalizePrice(price), g_digits), lot);
      step *= InpStepMultiplier;
      lot  *= InpLotMultiplier;
     }

   double tickVal = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double perUnit = (g_tick > 0.0) ? (tickVal / g_tick) * totalLots : 0.0;

   PrintFormat("  Full ladder: %.2f lots, span %s -> %s",
               totalLots, DoubleToString(NormalizePrice(ref), g_digits),
               DoubleToString(NormalizePrice(price), g_digits));
   PrintFormat("  At full load you carry ~%.2f %s per 1.00 price unit against you.",
               perUnit, AccountInfoString(ACCOUNT_CURRENCY));
   PrintFormat("  Stop loss: OFF. Equity %.2f.", AccountInfoDouble(ACCOUNT_EQUITY));
   Print("------------------------------------------");
  }
