//+------------------------------------------------------------------+
//|                                             M15_ZoneFinder.mq5   |
//|                  Real-time buy/sell zone engine for the M15 TF   |
//|                                                                  |
//|  WHAT IT DOES                                                    |
//|   1. Maps market structure on M15 (swing pivots -> BOS / CHoCH)  |
//|   2. Drops a demand (buy) or supply (sell) zone at the ORIGIN of |
//|      every confirmed displacement move (the last opposing candle |
//|      before the impulse = order block)                           |
//|   3. Optionally adds Fair Value Gap zones                        |
//|   4. Scores every zone for confluence (HTF bias, displacement,   |
//|      FVG overlap, premium/discount location, freshness, volume)  |
//|   5. Only zones scoring >= InpMinScore are drawn as "viable"     |
//|   6. Live-tracks price into the zone, alerts on entry, and       |
//|      prints a non-repainting arrow when a confirmation candle    |
//|      closes inside it                                            |
//|                                                                  |
//|  BUFFERS (for iCustom access from an EA)                         |
//|   0 = Buy arrow price   (0 = no signal)                          |
//|   1 = Sell arrow price  (0 = no signal)                          |
//|   2 = Active zone top                                            |
//|   3 = Active zone bottom                                         |
//|   4 = Active zone direction (+1 demand / -1 supply / 0 none)     |
//|   5 = Active zone score                                          |
//+------------------------------------------------------------------+
#property copyright "M15 Zone Finder"
#property version   "1.00"
#property description "SMC supply/demand zone engine with confluence scoring for M15"
#property indicator_chart_window
#property indicator_buffers 6
#property indicator_plots   2

//--- plot 1 : Buy signal
#property indicator_label1  "BuySignal"
#property indicator_type1   DRAW_ARROW
#property indicator_color1  clrDodgerBlue
#property indicator_width1  2
//--- plot 2 : Sell signal
#property indicator_label2  "SellSignal"
#property indicator_type2   DRAW_ARROW
#property indicator_color2  clrOrangeRed
#property indicator_width2  2

//+------------------------------------------------------------------+
//| Inputs                                                            |
//+------------------------------------------------------------------+
input group "=== Structure ==="
input int      InpPivotLen        = 3;        // Swing pivot strength (bars each side)
input int      InpMaxBars         = 1500;     // Max history bars to scan
input int      InpOBLookback      = 12;       // Bars to search back for the origin candle

input group "=== Zone creation ==="
input bool     InpUseBOS_OB       = true;     // Zones from BOS/CHoCH order blocks
input bool     InpUseImpulseOB    = true;     // Zones from raw displacement candles
input bool     InpUseFVG          = true;     // Zones from Fair Value Gaps
input double   InpImpulseATR      = 1.20;     // Displacement size (x ATR) to qualify
input bool     InpZoneBodyOnly    = false;    // Zone = candle body (true) or full range (false)
input double   InpMinZoneATR      = 0.15;     // Reject zones thinner than this (x ATR)
input double   InpMaxZoneATR      = 2.50;     // Reject zones fatter than this (x ATR)
input int      InpMaxZones        = 14;       // Max live zones kept per side

input group "=== Confluence scoring ==="
input int      InpMinScore        = 4;        // Minimum score for a zone to be shown/traded
input bool     InpRequireHTF      = true;     // Signal only in the direction of HTF bias
input ENUM_TIMEFRAMES InpHTF      = PERIOD_H1;// Higher timeframe for bias
input int      InpHTF_Fast        = 21;       // HTF fast EMA
input int      InpHTF_Slow        = 50;       // HTF slow EMA
input int      InpRangeLookback   = 60;       // Bars used for premium/discount range
input int      InpVolAvgPeriod    = 20;       // Tick-volume average period

input group "=== Mitigation & entry ==="
input bool     InpWickMitigation  = false;    // Kill zone on wick (true) or close (false)
input double   InpConfirmWickRat  = 0.50;     // Min rejection-wick ratio of the candle
input bool     InpNeedEngulf      = false;    // Also require the candle to engulf the prior

input group "=== Sessions (server time, 0-23) ==="
input bool     InpUseSession      = false;    // Restrict signals to a session window
input int      InpSessionStart    = 7;        // Session start hour
input int      InpSessionEnd      = 20;       // Session end hour

input group "=== Alerts ==="
input bool     InpAlertZoneTouch  = true;     // Live alert when price taps a zone
input bool     InpAlertConfirmed  = true;     // Alert on confirmed signal candle
input bool     InpPushNotify      = false;    // Send push notification
input bool     InpEmailAlert      = false;    // Send email

input group "=== Visuals ==="
input bool     InpShowZones       = true;     // Draw zone rectangles
input bool     InpShowLabels      = true;     // Draw zone score labels
input bool     InpShowStructure   = true;     // Draw BOS / CHoCH lines
input bool     InpShowPanel       = true;     // Draw info panel
input int      InpZoneExtendBars  = 30;       // Extend zones this many bars to the right
input color    InpDemandColor     = clrTeal;  // Demand (buy) zone colour
input color    InpSupplyColor     = clrCrimson;// Supply (sell) zone colour
input color    InpFVGDemandColor  = clrDarkSlateGray; // Demand FVG colour
input color    InpFVGSupplyColor  = clrDarkSlateBlue; // Supply FVG colour
input color    InpTextColor       = clrGainsboro;     // Panel text colour

//+------------------------------------------------------------------+
//| Buffers                                                           |
//+------------------------------------------------------------------+
double BuyBuf[];
double SellBuf[];
double ZoneTopBuf[];
double ZoneBotBuf[];
double ZoneDirBuf[];
double ZoneScoreBuf[];

//+------------------------------------------------------------------+
//| Globals                                                           |
//+------------------------------------------------------------------+
#define PFX "ZF_"

struct SZone
{
   int      id;
   int      dir;         // +1 demand (buy) / -1 supply (sell)
   double   top;
   double   bottom;
   datetime tstart;
   bool     isFVG;
   bool     touched;
   bool     signaled;
   bool     mitigated;
   int      score;
   string   origin;      // "CHoCH" / "BOS" / "IMP" / "FVG"
};

SZone    g_zones[];
int      g_zoneId       = 0;

double   g_atr[];
int      g_hATR         = INVALID_HANDLE;
int      g_hHTFfast     = INVALID_HANDLE;
int      g_hHTFslow     = INVALID_HANDLE;

// structure state
double   g_lastPH       = 0.0;
double   g_lastPL       = 0.0;
datetime g_lastPHtime   = 0;
datetime g_lastPLtime   = 0;
int      g_trend        = 0;      // +1 bull / -1 bear / 0 none
datetime g_lastBarDone  = 0;      // last bar timestamp fully processed

// runtime state
int      g_htfBias      = 0;
datetime g_lastTouchAlert   = 0;
datetime g_lastSignalAlert  = 0;
string   g_lastSignalTxt    = "none";
int      g_activeIdx        = -1;

//+------------------------------------------------------------------+
//| Init                                                              |
//+------------------------------------------------------------------+
int OnInit()
{
   SetIndexBuffer(0, BuyBuf,       INDICATOR_DATA);
   SetIndexBuffer(1, SellBuf,      INDICATOR_DATA);
   SetIndexBuffer(2, ZoneTopBuf,   INDICATOR_CALCULATIONS);
   SetIndexBuffer(3, ZoneBotBuf,   INDICATOR_CALCULATIONS);
   SetIndexBuffer(4, ZoneDirBuf,   INDICATOR_CALCULATIONS);
   SetIndexBuffer(5, ZoneScoreBuf, INDICATOR_CALCULATIONS);

   PlotIndexSetInteger(0, PLOT_ARROW, 233);
   PlotIndexSetInteger(1, PLOT_ARROW, 234);
   PlotIndexSetInteger(0, PLOT_ARROW_SHIFT,  12);
   PlotIndexSetInteger(1, PLOT_ARROW_SHIFT, -12);
   PlotIndexSetDouble(0, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(1, PLOT_EMPTY_VALUE, 0.0);

   ArraySetAsSeries(BuyBuf,       false);
   ArraySetAsSeries(SellBuf,      false);
   ArraySetAsSeries(ZoneTopBuf,   false);
   ArraySetAsSeries(ZoneBotBuf,   false);
   ArraySetAsSeries(ZoneDirBuf,   false);
   ArraySetAsSeries(ZoneScoreBuf, false);
   ArraySetAsSeries(g_atr,        false);

   g_hATR     = iATR(_Symbol, PERIOD_CURRENT, 14);
   g_hHTFfast = iMA(_Symbol, InpHTF, InpHTF_Fast, 0, MODE_EMA, PRICE_CLOSE);
   g_hHTFslow = iMA(_Symbol, InpHTF, InpHTF_Slow, 0, MODE_EMA, PRICE_CLOSE);

   if(g_hATR == INVALID_HANDLE || g_hHTFfast == INVALID_HANDLE || g_hHTFslow == INVALID_HANDLE)
   {
      Print("M15_ZoneFinder: failed to create indicator handles");
      return INIT_FAILED;
   }

   IndicatorSetString(INDICATOR_SHORTNAME, "M15 Zone Finder");
   IndicatorSetInteger(INDICATOR_DIGITS, _Digits);

   if(Period() != PERIOD_M15)
      Print("M15_ZoneFinder: designed for M15. Current chart TF is ",
            EnumToString((ENUM_TIMEFRAMES)Period()), " - logic still runs but tune the inputs.");

   ArrayResize(g_zones, 0);
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Deinit                                                            |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   ObjectsDeleteAll(0, PFX);
   if(g_hATR     != INVALID_HANDLE) IndicatorRelease(g_hATR);
   if(g_hHTFfast != INVALID_HANDLE) IndicatorRelease(g_hHTFfast);
   if(g_hHTFslow != INVALID_HANDLE) IndicatorRelease(g_hHTFslow);
   ChartRedraw();
}

//+------------------------------------------------------------------+
//| Helpers                                                           |
//+------------------------------------------------------------------+
bool IsPivotHigh(const int p, const double &high[], const int total)
{
   if(p - InpPivotLen < 0 || p + InpPivotLen >= total) return false;
   double v = high[p];
   for(int k = p - InpPivotLen; k <= p + InpPivotLen; k++)
   {
      if(k == p) continue;
      if(high[k] >= v) return false;
   }
   return true;
}

bool IsPivotLow(const int p, const double &low[], const int total)
{
   if(p - InpPivotLen < 0 || p + InpPivotLen >= total) return false;
   double v = low[p];
   for(int k = p - InpPivotLen; k <= p + InpPivotLen; k++)
   {
      if(k == p) continue;
      if(low[k] <= v) return false;
   }
   return true;
}

double ATRat(const int i)
{
   if(i < 0 || i >= ArraySize(g_atr)) return 0.0;
   double a = g_atr[i];
   if(a <= 0.0) a = 10 * _Point;
   return a;
}

void RangeAt(const int i, const int lookback, const double &high[], const double &low[],
             double &hi, double &lo)
{
   hi = -DBL_MAX; lo = DBL_MAX;
   int from = MathMax(0, i - lookback);
   for(int k = from; k <= i; k++)
   {
      if(high[k] > hi) hi = high[k];
      if(low[k]  < lo) lo = low[k];
   }
}

double AvgVolume(const int i, const long &tv[])
{
   int from = MathMax(0, i - InpVolAvgPeriod + 1);
   double s = 0; int n = 0;
   for(int k = from; k <= i; k++){ s += (double)tv[k]; n++; }
   return (n > 0 ? s / n : 0.0);
}

bool InSession(const datetime t)
{
   if(!InpUseSession) return true;
   MqlDateTime dt;
   TimeToStruct(t, dt);
   if(InpSessionStart <= InpSessionEnd)
      return (dt.hour >= InpSessionStart && dt.hour < InpSessionEnd);
   return (dt.hour >= InpSessionStart || dt.hour < InpSessionEnd);
}

void UpdateHTFBias()
{
   double f[], s[];
   ArraySetAsSeries(f, true);
   ArraySetAsSeries(s, true);
   g_htfBias = 0;
   if(CopyBuffer(g_hHTFfast, 0, 0, 2, f) < 2) return;
   if(CopyBuffer(g_hHTFslow, 0, 0, 2, s) < 2) return;
   double c = iClose(_Symbol, InpHTF, 0);
   if(c <= 0) return;
   if(f[0] > s[0] && c > f[0]) g_htfBias =  1;
   else if(f[0] < s[0] && c < f[0]) g_htfBias = -1;
}

//+------------------------------------------------------------------+
//| Zone management                                                   |
//+------------------------------------------------------------------+
bool ZoneOverlaps(const int dir, const double top, const double bottom)
{
   int n = ArraySize(g_zones);
   for(int i = 0; i < n; i++)
   {
      if(g_zones[i].mitigated) continue;
      if(g_zones[i].dir != dir) continue;
      double ovTop = MathMin(top, g_zones[i].top);
      double ovBot = MathMax(bottom, g_zones[i].bottom);
      double ov    = ovTop - ovBot;
      if(ov <= 0) continue;
      double h = MathMax(top - bottom, g_zones[i].top - g_zones[i].bottom);
      if(h > 0 && ov / h > 0.55) return true;
   }
   return false;
}

void ZoneDelete(const int idx)
{
   if(idx < 0 || idx >= ArraySize(g_zones)) return;
   string base = PFX + "Z" + IntegerToString(g_zones[idx].id);
   ObjectDelete(0, base);
   ObjectDelete(0, base + "_lbl");
   ArrayRemove(g_zones, idx, 1);
}

void ZonePrune()
{
   // drop mitigated zones and cap the count per side
   for(int i = ArraySize(g_zones) - 1; i >= 0; i--)
      if(g_zones[i].mitigated) ZoneDelete(i);

   int cntD = 0, cntS = 0;
   for(int i = ArraySize(g_zones) - 1; i >= 0; i--)
   {
      if(g_zones[i].dir > 0)
      {
         cntD++;
         if(cntD > InpMaxZones) ZoneDelete(i);
      }
      else
      {
         cntS++;
         if(cntS > InpMaxZones) ZoneDelete(i);
      }
   }
}

void ZoneDraw(const int idx, const datetime rightEdge)
{
   if(!InpShowZones) return;
   if(idx < 0 || idx >= ArraySize(g_zones)) return;

   SZone z = g_zones[idx];
   string name = PFX + "Z" + IntegerToString(z.id);

   color col;
   if(z.isFVG) col = (z.dir > 0 ? InpFVGDemandColor : InpFVGSupplyColor);
   else        col = (z.dir > 0 ? InpDemandColor    : InpSupplyColor);

   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, z.tstart, z.top, rightEdge, z.bottom);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_FILL, true);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
   }
   ObjectSetInteger(0, name, OBJPROP_COLOR, col);
   ObjectSetInteger(0, name, OBJPROP_STYLE, z.touched ? STYLE_DOT : STYLE_SOLID);
   ObjectSetInteger(0, name, OBJPROP_TIME, 0, z.tstart);
   ObjectSetInteger(0, name, OBJPROP_TIME, 1, rightEdge);
   ObjectSetDouble(0, name, OBJPROP_PRICE, 0, z.top);
   ObjectSetDouble(0, name, OBJPROP_PRICE, 1, z.bottom);

   if(InpShowLabels)
   {
      string ln = name + "_lbl";
      string txt = StringFormat("%s %s  [%d]", (z.dir > 0 ? "DEMAND" : "SUPPLY"), z.origin, z.score);
      double py = (z.dir > 0 ? z.bottom : z.top);
      if(ObjectFind(0, ln) < 0)
      {
         ObjectCreate(0, ln, OBJ_TEXT, 0, z.tstart, py);
         ObjectSetInteger(0, ln, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, ln, OBJPROP_HIDDEN, true);
         ObjectSetInteger(0, ln, OBJPROP_FONTSIZE, 7);
         ObjectSetString(0, ln, OBJPROP_FONT, "Arial");
      }
      ObjectSetString(0, ln, OBJPROP_TEXT, txt);
      ObjectSetInteger(0, ln, OBJPROP_COLOR, col);
      ObjectSetInteger(0, ln, OBJPROP_ANCHOR, (z.dir > 0 ? ANCHOR_LEFT_UPPER : ANCHOR_LEFT_LOWER));
      ObjectSetInteger(0, ln, OBJPROP_TIME, 0, z.tstart);
      ObjectSetDouble(0, ln, OBJPROP_PRICE, 0, py);
   }
}

//+------------------------------------------------------------------+
//| Scoring                                                           |
//+------------------------------------------------------------------+
int ScoreZone(const int dir, const int bar, const double top, const double bottom,
              const bool fromBreak, const bool isCHoCH, const bool hasFVG,
              const double displacement,
              const double &high[], const double &low[], const long &tv[])
{
   int sc = 1;                                    // base

   if(fromBreak)  sc += (isCHoCH ? 2 : 1);        // structural origin
   if(hasFVG)     sc += 1;                        // imbalance inside the zone

   double atr = ATRat(bar);
   if(atr > 0 && displacement >= InpImpulseATR * 1.8 * atr) sc += 1;   // strong leg

   if(g_htfBias == dir) sc += 1;                  // HTF alignment

   // premium / discount
   double hi, lo;
   RangeAt(bar, InpRangeLookback, high, low, hi, lo);
   if(hi > lo)
   {
      double mid = (hi + lo) * 0.5;
      double mz  = (top + bottom) * 0.5;
      if(dir > 0 && mz < mid) sc += 1;            // demand in discount
      if(dir < 0 && mz > mid) sc += 1;            // supply in premium
   }

   // participation
   double av = AvgVolume(bar, tv);
   if(av > 0 && (double)tv[bar] > av * 1.3) sc += 1;

   return sc;
}

//+------------------------------------------------------------------+
//| FVG lookup around a bar                                           |
//+------------------------------------------------------------------+
bool FVGNear(const int bar, const int dir, const double top, const double bottom,
             const double &high[], const double &low[], const int total)
{
   int from = MathMax(2, bar - 2);
   int to   = MathMin(total - 1, bar + 4);
   for(int i = from; i <= to; i++)
   {
      double gTop = 0, gBot = 0;
      bool ok = false;
      if(dir > 0 && low[i] > high[i - 2]) { gTop = low[i];  gBot = high[i - 2]; ok = true; }
      if(dir < 0 && high[i] < low[i - 2]) { gTop = low[i - 2]; gBot = high[i];  ok = true; }
      if(!ok) continue;
      if(gTop >= bottom && gBot <= top) return true;   // overlaps the zone
   }
   return false;
}

//+------------------------------------------------------------------+
//| Create a zone from the origin candle of an impulse                |
//+------------------------------------------------------------------+
void BuildZone(const int dir, const int breakBar, const bool fromBreak, const bool isCHoCH,
               const string origin,
               const double &open[], const double &high[], const double &low[],
               const double &close[], const datetime &time[], const long &tv[],
               const int total)
{
   int originBar = -1;
   int from = MathMax(1, breakBar - InpOBLookback);

   // walk back to the last candle opposing the impulse
   for(int i = breakBar; i >= from; i--)
   {
      if(dir > 0 && close[i] < open[i]) { originBar = i; break; }   // last down candle
      if(dir < 0 && close[i] > open[i]) { originBar = i; break; }   // last up candle
   }
   if(originBar < 0) return;

   double top, bottom;
   if(InpZoneBodyOnly)
   {
      top    = MathMax(open[originBar], close[originBar]);
      bottom = MathMin(open[originBar], close[originBar]);
   }
   else
   {
      top    = high[originBar];
      bottom = low[originBar];
   }
   if(top <= bottom) return;

   double atr = ATRat(originBar);
   double h   = top - bottom;
   if(atr > 0 && (h < InpMinZoneATR * atr || h > InpMaxZoneATR * atr)) return;

   // the zone must still be unvisited between its origin and the break
   for(int i = originBar + 1; i <= breakBar; i++)
   {
      if(dir > 0 && low[i]  < bottom) return;
      if(dir < 0 && high[i] > top)    return;
   }

   if(ZoneOverlaps(dir, top, bottom)) return;

   double displacement = (dir > 0 ? close[breakBar] - bottom : top - close[breakBar]);
   bool   hasFVG       = FVGNear(originBar, dir, top, bottom, high, low, total);

   SZone z;
   z.id        = ++g_zoneId;
   z.dir       = dir;
   z.top       = top;
   z.bottom    = bottom;
   z.tstart    = time[originBar];
   z.isFVG     = false;
   z.touched   = false;
   z.signaled  = false;
   z.mitigated = false;
   z.origin    = origin;
   z.score     = ScoreZone(dir, originBar, top, bottom, fromBreak, isCHoCH, hasFVG,
                           displacement, high, low, tv);

   if(z.score < InpMinScore) return;

   int n = ArraySize(g_zones);
   ArrayResize(g_zones, n + 1);
   g_zones[n] = z;
}

//+------------------------------------------------------------------+
//| Create a standalone FVG zone                                      |
//+------------------------------------------------------------------+
void BuildFVG(const int i, const double &high[], const double &low[], const double &close[],
              const datetime &time[], const long &tv[], const int total)
{
   if(i < 2) return;
   double atr = ATRat(i);
   if(atr <= 0) return;

   int    dir = 0;
   double top = 0, bottom = 0;

   if(low[i] > high[i - 2])       { dir =  1; top = low[i];      bottom = high[i - 2]; }
   else if(high[i] < low[i - 2])  { dir = -1; top = low[i - 2];  bottom = high[i];     }
   else return;

   double h = top - bottom;
   if(h < InpMinZoneATR * atr || h > InpMaxZoneATR * atr) return;
   if(ZoneOverlaps(dir, top, bottom)) return;

   SZone z;
   z.id        = ++g_zoneId;
   z.dir       = dir;
   z.top       = top;
   z.bottom    = bottom;
   z.tstart    = time[i - 2];
   z.isFVG     = true;
   z.touched   = false;
   z.signaled  = false;
   z.mitigated = false;
   z.origin    = "FVG";
   z.score     = ScoreZone(dir, i, top, bottom, false, false, true, h, high, low, tv);

   if(z.score < InpMinScore) return;

   int n = ArraySize(g_zones);
   ArrayResize(g_zones, n + 1);
   g_zones[n] = z;
}

