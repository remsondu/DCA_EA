void DrawStructure(const string tag, const datetime t1, const datetime t2,
                   const double price, const bool bull)
{
   if(!InpShowStructure) return;
   string name = PFX + "S" + IntegerToString((int)t2) + tag;
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_TREND, 0, t1, price, t2, price);
      ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, name, OBJPROP_COLOR, bull ? InpDemandColor : InpSupplyColor);

      string ln = name + "t";
      ObjectCreate(0, ln, OBJ_TEXT, 0, t2, price);
      ObjectSetString(0, ln, OBJPROP_TEXT, tag);
      ObjectSetInteger(0, ln, OBJPROP_FONTSIZE, 7);
      ObjectSetInteger(0, ln, OBJPROP_COLOR, bull ? InpDemandColor : InpSupplyColor);
      ObjectSetInteger(0, ln, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, ln, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, ln, OBJPROP_ANCHOR, bull ? ANCHOR_LEFT_LOWER : ANCHOR_LEFT_UPPER);
   }
}

//+------------------------------------------------------------------+
//| Process one CLOSED bar: structure, breaks, zone creation          |
//+------------------------------------------------------------------+
void ProcessBar(const int i, const int total,
                const double &open[], const double &high[], const double &low[],
                const double &close[], const datetime &time[], const long &tv[])
{
   // --- confirm pivots that are now InpPivotLen bars old
   int p = i - InpPivotLen;
   if(p > InpPivotLen)
   {
      if(IsPivotHigh(p, high, total)) { g_lastPH = high[p]; g_lastPHtime = time[p]; }
      if(IsPivotLow(p, low, total))   { g_lastPL = low[p];  g_lastPLtime = time[p];  }
   }

   double atr = ATRat(i);
   if(atr <= 0) return;

   // --- break of structure detection
   if(InpUseBOS_OB)
   {
      if(g_lastPH > 0 && close[i] > g_lastPH)
      {
         bool isCHoCH = (g_trend == -1);
         double disp  = close[i] - g_lastPH;
         if(disp >= 0.10 * atr)
         {
            DrawStructure(isCHoCH ? "CHoCH" : "BOS", g_lastPHtime, time[i], g_lastPH, true);
            BuildZone(1, i, true, isCHoCH, isCHoCH ? "CHoCH" : "BOS",
                      open, high, low, close, time, tv, total);
            g_trend  = 1;
            g_lastPH = 0.0;   // consumed
         }
      }
      if(g_lastPL > 0 && close[i] < g_lastPL)
      {
         bool isCHoCH = (g_trend == 1);
         double disp  = g_lastPL - close[i];
         if(disp >= 0.10 * atr)
         {
            DrawStructure(isCHoCH ? "CHoCH" : "BOS", g_lastPLtime, time[i], g_lastPL, false);
            BuildZone(-1, i, true, isCHoCH, isCHoCH ? "CHoCH" : "BOS",
                      open, high, low, close, time, tv, total);
            g_trend  = -1;
            g_lastPL = 0.0;
         }
      }
   }

   // --- raw displacement candle (no structural break required)
   if(InpUseImpulseOB && i >= 2)
   {
      double body  = MathAbs(close[i] - open[i]);
      double range = high[i] - low[i];
      if(body >= InpImpulseATR * atr && range > 0 && body / range > 0.60)
      {
         int dir = (close[i] > open[i] ? 1 : -1);
         BuildZone(dir, i, false, false, "IMP", open, high, low, close, time, tv, total);
      }
   }

   // --- fair value gaps
   if(InpUseFVG)
      BuildFVG(i, high, low, close, time, tv, total);
}

//+------------------------------------------------------------------+
//| Mitigation + touch + confirmation on a closed bar                 |
//+------------------------------------------------------------------+
void EvaluateZones(const int i, const double &open[], const double &high[], const double &low[],
                   const double &close[], const datetime &time[])
{
   for(int z = ArraySize(g_zones) - 1; z >= 0; z--)
   {
      if(g_zones[z].mitigated) continue;
      if(time[i] < g_zones[z].tstart) continue;

      double top = g_zones[z].top, bot = g_zones[z].bottom;
      int    dir = g_zones[z].dir;

      // --- mitigation (zone traded through)
      bool killed = false;
      if(dir > 0) killed = (InpWickMitigation ? low[i]  < bot : close[i] < bot);
      else        killed = (InpWickMitigation ? high[i] > top : close[i] > top);
      if(killed) { g_zones[z].mitigated = true; continue; }

      // --- price inside the zone?
      bool inside = (dir > 0 ? (low[i]  <= top && high[i] >= bot)
                             : (high[i] >= bot && low[i]  <= top));
      if(!inside) continue;
      g_zones[z].touched = true;

      if(g_zones[z].signaled) continue;
      if(!InSession(time[i])) continue;
      if(InpRequireHTF && g_htfBias != dir) continue;

      // --- confirmation candle
      double range = high[i] - low[i];
      if(range <= 0) continue;

      bool bull = (close[i] > open[i]);
      double lowerWick = (MathMin(open[i], close[i]) - low[i]) / range;
      double upperWick = (high[i] - MathMax(open[i], close[i])) / range;
      double closePos  = (close[i] - low[i]) / range;

      bool ok = false;
      if(dir > 0)
         ok = bull && closePos >= InpConfirmWickRat && close[i] > bot &&
              (lowerWick >= 0.20 || closePos >= 0.70);
      else
         ok = !bull && (1.0 - closePos) >= InpConfirmWickRat && close[i] < top &&
              (upperWick >= 0.20 || closePos <= 0.30);

      if(ok && InpNeedEngulf && i >= 1)
      {
         if(dir > 0) ok = (close[i] > MathMax(open[i - 1], close[i - 1]));
         else        ok = (close[i] < MathMin(open[i - 1], close[i - 1]));
      }
      if(!ok) continue;

      g_zones[z].signaled = true;

      double off = 0.6 * ATRat(i);
      if(dir > 0) BuyBuf[i]  = low[i]  - off;
      else        SellBuf[i] = high[i] + off;

      g_lastSignalTxt = StringFormat("%s @ %s (score %d, %s)",
                                     (dir > 0 ? "BUY" : "SELL"),
                                     DoubleToString((top + bot) * 0.5, _Digits),
                                     g_zones[z].score, g_zones[z].origin);

      if(InpAlertConfirmed && time[i] != g_lastSignalAlert)
      {
         g_lastSignalAlert = time[i];
         string msg = StringFormat("%s M15 ZoneFinder: %s confirmed | zone %s-%s | score %d",
                                   _Symbol, (dir > 0 ? "BUY" : "SELL"),
                                   DoubleToString(bot, _Digits), DoubleToString(top, _Digits),
                                   g_zones[z].score);
         Alert(msg);
         if(InpPushNotify) SendNotification(msg);
         if(InpEmailAlert) SendMail("M15 ZoneFinder", msg);
      }
   }
}

//+------------------------------------------------------------------+
//| Live tick check: heads-up when price taps a fresh viable zone     |
//+------------------------------------------------------------------+
void LiveZoneWatch()
{
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(bid <= 0) return;

   g_activeIdx = -1;
   double best = DBL_MAX;

   for(int z = 0; z < ArraySize(g_zones); z++)
   {
      if(g_zones[z].mitigated) continue;
      double top = g_zones[z].top, bot = g_zones[z].bottom;
      if(bid <= top && bid >= bot)
      {
         double d = MathAbs(bid - (top + bot) * 0.5);
         if(d < best) { best = d; g_activeIdx = z; }

         if(InpAlertZoneTouch && !g_zones[z].touched && !g_zones[z].signaled)
         {
            datetime bt = iTime(_Symbol, PERIOD_CURRENT, 0);
            if(bt != g_lastTouchAlert)
            {
               g_lastTouchAlert = bt;
               string msg = StringFormat("%s M15 ZoneFinder: price tapped %s zone %s-%s (score %d) - watch for confirmation",
                                         _Symbol, (g_zones[z].dir > 0 ? "DEMAND" : "SUPPLY"),
                                         DoubleToString(bot, _Digits), DoubleToString(top, _Digits),
                                         g_zones[z].score);
               Alert(msg);
               if(InpPushNotify) SendNotification(msg);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Panel                                                             |
//+------------------------------------------------------------------+
void PanelLine(const int idx, const string txt, const color col)
{
   string name = PFX + "P" + IntegerToString(idx);
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_XDISTANCE, 12);
      ObjectSetInteger(0, name, OBJPROP_YDISTANCE, 18 + idx * 14);
      ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   }
   ObjectSetString(0, name, OBJPROP_TEXT, txt);
   ObjectSetInteger(0, name, OBJPROP_COLOR, col);
}

void DrawPanel()
{
   if(!InpShowPanel) return;

   int nd = 0, ns = 0, nf = 0;
   for(int i = 0; i < ArraySize(g_zones); i++)
   {
      if(g_zones[i].mitigated) continue;
      if(g_zones[i].dir > 0) nd++; else ns++;
      if(!g_zones[i].touched) nf++;
   }

   string biasTxt = (g_htfBias > 0 ? "BULLISH" : (g_htfBias < 0 ? "BEARISH" : "NEUTRAL"));
   color  biasCol = (g_htfBias > 0 ? InpDemandColor : (g_htfBias < 0 ? InpSupplyColor : InpTextColor));
   string strTxt  = (g_trend > 0 ? "BULLISH" : (g_trend < 0 ? "BEARISH" : "UNDEFINED"));

   PanelLine(0, "M15 ZONE FINDER  " + _Symbol + "  " + EnumToString((ENUM_TIMEFRAMES)Period()), InpTextColor);
   PanelLine(1, "HTF bias (" + EnumToString(InpHTF) + "): " + biasTxt, biasCol);
   PanelLine(2, "M15 structure     : " + strTxt, InpTextColor);
   PanelLine(3, StringFormat("Live zones        : %d demand / %d supply (%d fresh)", nd, ns, nf), InpTextColor);

   if(g_activeIdx >= 0 && g_activeIdx < ArraySize(g_zones))
   {
      SZone z = g_zones[g_activeIdx];
      PanelLine(4, StringFormat("IN ZONE >> %s %s-%s score %d",
                (z.dir > 0 ? "DEMAND" : "SUPPLY"),
                DoubleToString(z.bottom, _Digits), DoubleToString(z.top, _Digits), z.score),
                (z.dir > 0 ? InpDemandColor : InpSupplyColor));
   }
   else PanelLine(4, "IN ZONE >> price is outside all zones", InpTextColor);

   PanelLine(5, "Last signal       : " + g_lastSignalTxt, InpTextColor);
}

//+------------------------------------------------------------------+
//| OnCalculate                                                       |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if(rates_total < 250) return 0;

   ArraySetAsSeries(time,        false);
   ArraySetAsSeries(open,        false);
   ArraySetAsSeries(high,        false);
   ArraySetAsSeries(low,         false);
   ArraySetAsSeries(close,       false);
   ArraySetAsSeries(tick_volume, false);

   //--- ATR sync
   if(ArraySize(g_atr) != rates_total) ArrayResize(g_atr, rates_total);
   int need = (prev_calculated == 0 ? rates_total : MathMin(rates_total, rates_total - prev_calculated + 5));
   need = MathMax(need, 3);
   double tmp[];
   ArraySetAsSeries(tmp, false);
   if(CopyBuffer(g_hATR, 0, 0, need, tmp) == need)
      for(int k = 0; k < need; k++) g_atr[rates_total - need + k] = tmp[k];

   int start;
   if(prev_calculated == 0)
   {
      ArrayInitialize(BuyBuf,       0.0);
      ArrayInitialize(SellBuf,      0.0);
      ArrayInitialize(ZoneTopBuf,   0.0);
      ArrayInitialize(ZoneBotBuf,   0.0);
      ArrayInitialize(ZoneDirBuf,   0.0);
      ArrayInitialize(ZoneScoreBuf, 0.0);

      ObjectsDeleteAll(0, PFX);
      ArrayResize(g_zones, 0);
      g_zoneId = 0;
      g_trend = 0; g_lastPH = 0; g_lastPL = 0;
      g_lastBarDone = 0;

      start = MathMax(InpPivotLen * 2 + 5, rates_total - InpMaxBars);
   }
   else
      start = MathMax(prev_calculated - 2, InpPivotLen * 2 + 5);

   UpdateHTFBias();

   //--- process only CLOSED bars (index rates_total-1 is still forming)
   for(int i = start; i <= rates_total - 2; i++)
   {
      if(time[i] <= g_lastBarDone) continue;

      BuyBuf[i]  = 0.0;
      SellBuf[i] = 0.0;

      ProcessBar(i, rates_total, open, high, low, close, time, tick_volume);
      EvaluateZones(i, open, high, low, close, time);

      g_lastBarDone = time[i];
   }

   BuyBuf[rates_total - 1]  = 0.0;
   SellBuf[rates_total - 1] = 0.0;

   ZonePrune();
   LiveZoneWatch();

   //--- draw / refresh zones
   datetime rightEdge = time[rates_total - 1] + (datetime)(PeriodSeconds() * InpZoneExtendBars);
   for(int z = 0; z < ArraySize(g_zones); z++) ZoneDraw(z, rightEdge);

   //--- export the active zone on the last bar for iCustom consumers
   int last = rates_total - 1;
   if(g_activeIdx >= 0 && g_activeIdx < ArraySize(g_zones))
   {
      ZoneTopBuf[last]   = g_zones[g_activeIdx].top;
      ZoneBotBuf[last]   = g_zones[g_activeIdx].bottom;
      ZoneDirBuf[last]   = (double)g_zones[g_activeIdx].dir;
      ZoneScoreBuf[last] = (double)g_zones[g_activeIdx].score;
   }
   else
   {
      ZoneTopBuf[last]   = 0.0;
      ZoneBotBuf[last]   = 0.0;
      ZoneDirBuf[last]   = 0.0;
      ZoneScoreBuf[last] = 0.0;
   }

   DrawPanel();
   ChartRedraw();

   return rates_total;
}
